# --- Model (sized for RTX 5050 Laptop, 8GB) ---
MODEL=Qwen/Qwen2.5-Coder-7B-Instruct-AWQ
SERVED_NAME=qwen2.5-coder-7b
MAX_MODEL_LEN=4096
GPU_MEM_UTIL=0.80
TP_SIZE=1
# --enforce-eager skips CUDA graphs: saves VRAM, costs some speed
EXTRA_ARGS=--quantization awq --max-num-seqs 8 --enforce-eager --enable-auto-tool-choice --tool-call-parser hermes

# --- Secrets (CHANGE THESE) ---
HF_TOKEN=xxxxxx
VLLM_API_KEY=change-me-long-random-string
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me

# --- Blackwell (sm_120) needs a recent image; v0.9.x failed on RTX 50 cards.
# After it works, check the vLLM version in the logs and pin that tag here.
VLLM_VERSION=v0.32.0
PROM_RETENTION=15d
