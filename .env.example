# Copy to .env and edit:  cp .env.example .env
# NEVER commit .env

# ---------- Model ----------
# Sized for an 8GB GPU (RTX 5050 laptop). See README "Model sizing" for other GPUs.
MODEL=Qwen/Qwen2.5-Coder-7B-Instruct-AWQ
SERVED_NAME=qwen2.5-coder-7b
MAX_MODEL_LEN=4096
GPU_MEM_UTIL=0.80
TP_SIZE=1
# Extra vLLM flags. --enable-auto-tool-choice/--tool-call-parser are needed by
# clients that send tools (Cursor, Continue, agents). 'hermes' fits Qwen2.5.
EXTRA_ARGS=--quantization awq --max-num-seqs 8 --enforce-eager --enable-auto-tool-choice --tool-call-parser hermes

# ---------- Secrets (required) ----------
# Generate: openssl rand -hex 32
VLLM_API_KEY=change-me-long-random-string
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
# Only needed for gated Hugging Face models
HF_TOKEN=xxxx

# ---------- Network ----------
# 127.0.0.1 = local only (recommended; put a TLS reverse proxy in front).
# 0.0.0.0   = all interfaces (firewall it!).
BIND_ADDR=127.0.0.1

# ---------- Resource limits (vllm container) ----------
VLLM_CPUS=4
VLLM_MEM_LIMIT=10G

# ---------- Versions / retention ----------
# Pin an exact tag. Metric names and flags change between vLLM releases.
VLLM_VERSION=v0.32.0
PROM_RETENTION=15d

HF_CACHE_DIR=D:/models/hf